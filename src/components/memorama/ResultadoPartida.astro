<div class="resultado-overlay" data-memorama-resultado hidden>
  <section
    class="resultado"
    role="dialog"
    aria-modal="true"
    aria-labelledby="resultado-titulo"
    aria-describedby="resultado-descripcion"
  >
    <div class="resultado__contenido">
      <div class="resultado__icono" aria-hidden="true">🏆</div>

      <h2 id="resultado-titulo" data-resultado-titulo>¡Partida terminada!</h2>

      <p id="resultado-descripcion" data-resultado-mensaje>
        Aquí aparecerá el resultado de tu partida.
      </p>

      <div class="resultado__estadisticas">
        <div>
          <span>Puntuación</span>
          <strong data-resultado-puntos>0</strong>
        </div>

        <div>
          <span>Tiempo</span>
          <strong data-resultado-tiempo>00:00</strong>
        </div>

        <div>
          <span>Intentos</span>
          <strong data-resultado-intentos>0</strong>
        </div>

        <div>
          <span>Parejas</span>
          <strong data-resultado-parejas>0 / 8</strong>
        </div>
      </div>

      <button
        class="resultado__reiniciar"
        type="button"
        data-memorama-reiniciar
      >
        Jugar de nuevo
      </button>
    </div>
  </section>
</div>

<style>
  /* ==========================================
     Overlay
  ========================================== */

  .resultado-overlay[hidden] {
    display: none;
  }

  .resultado-overlay {
    position: fixed;
    inset: 0;
    z-index: 1000;

    display: flex;
    align-items: center;
    justify-content: center;

    width: 100%;
    height: 100dvh;
    padding: 1rem;

    box-sizing: border-box;
    overflow-y: auto;
    overscroll-behavior: contain;

    background: rgba(10, 18, 32, 0.78);
    backdrop-filter: blur(5px);
    -webkit-backdrop-filter: blur(5px);
  }

  /* ==========================================
     Contenedor del resultado
  ========================================== */

  .resultado {
    box-sizing: border-box;

    width: min(100%, 480px);
    max-height: calc(100dvh - 2rem);
    margin: auto;

    overflow-y: auto;
    overscroll-behavior: contain;

    padding: clamp(1rem, 4vw, 2rem);

    border-radius: 18px;
    background: #fff;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.25);

    text-align: center;
  }

  .resultado__contenido {
    width: 100%;
    min-width: 0;
  }

  /* ==========================================
     Encabezado
  ========================================== */

  .resultado__icono {
    font-size: clamp(2rem, 5vw, 3rem);
    line-height: 1.2;
  }

  .resultado h2 {
    margin: 0.75rem 0 0.5rem;

    color: #172033;
    font-size: clamp(1.4rem, 4vw, 2rem);
    line-height: 1.2;
  }

  .resultado p {
    margin: 0;

    color: #64748b;
    font-size: clamp(0.85rem, 2vw, 1rem);
    line-height: 1.5;
  }

  /* ==========================================
     Estadísticas
  ========================================== */

  .resultado__estadisticas {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));

    gap: 0.75rem;
    margin: 1.5rem 0;
  }

  .resultado__estadisticas > div {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;

    gap: 0.35rem;
    min-width: 0;
    padding: 0.85rem;

    border-radius: 12px;
    background: #f8fafc;
  }

  .resultado__estadisticas span {
    color: #64748b;
    font-size: 0.8rem;
    line-height: 1.3;
  }

  .resultado__estadisticas strong {
    color: #172033;
    font-size: clamp(1.1rem, 2.5vw, 1.5rem);
    font-weight: 800;
    font-variant-numeric: tabular-nums;
  }

  /* ==========================================
     Botón de reinicio
  ========================================== */

  .resultado__reiniciar {
    display: block;

    width: 100%;
    max-width: 280px;
    min-height: 48px;
    margin-inline: auto;
    padding: 0.85rem 1.25rem;

    border: 0;
    border-radius: 12px;

    background: #ea5b0c;
    color: #fff;

    font: inherit;
    font-weight: 700;
    line-height: 1.3;

    cursor: pointer;

    transition:
      background 0.2s ease,
      transform 0.2s ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .resultado__reiniciar:hover {
      background: #c94d09;
      transform: translateY(-2px);
    }
  }

  .resultado__reiniciar:active {
    transform: scale(0.98);
  }

  .resultado__reiniciar:focus-visible {
    outline: 3px solid #2563eb;
    outline-offset: 3px;
  }

  /* ==========================================
     Tabletas y escritorio
  ========================================== */

  @media (min-width: 600px) {
    .resultado {
      width: min(100%, 580px);
    }

    .resultado__estadisticas {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  /* ==========================================
     Dispositivos móviles
  ========================================== */

  @media (max-width: 480px) {
    .resultado-overlay {
      padding: 1rem;
    }

    .resultado {
      width: 100%;
      padding: 1.25rem 1rem;
      border-radius: 16px;
    }

    .resultado__icono {
      font-size: 2.5rem;
    }

    .resultado h2 {
      font-size: clamp(1.3rem, 5vw, 1.6rem);
    }

    .resultado p {
      font-size: 0.875rem;
    }

    .resultado__estadisticas {
      gap: 0.5rem;
      margin: 1.25rem 0;
    }

    .resultado__estadisticas > div {
      padding: 0.75rem 0.5rem;
    }

    .resultado__reiniciar {
      max-width: none;
    }
  }

  /* ==========================================
     Pantallas de poca altura
  ========================================== */

  @media (max-height: 500px) {
    .resultado-overlay {
      padding: 0.5rem;
    }

    .resultado {
      max-height: calc(100dvh - 1rem);
      padding: 0.75rem;
    }

    .resultado__icono {
      font-size: 1.75rem;
    }

    .resultado h2 {
      margin: 0.35rem 0;
    }

    .resultado__estadisticas {
      margin: 0.75rem 0;
    }
  }

  /* ==========================================
     Accesibilidad
  ========================================== */

  @media (prefers-reduced-motion: reduce) {
    .resultado__reiniciar {
      transition: none;
    }
  }
</style>
